# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Duke backend (backend/coordinator_api.py)
NEXT_PUBLIC_API_URL=https://labeelea1-labeele-duke-prod.hf.space

# Server-only - never expose to the browser. Must match JWT_SECRET on the
# Duke backend (backend/.env.example) EXACTLY - it's what lets this site
# verify its own session cookies (login/signup/admin gating in middleware.ts
# and lib/admin.ts) without a network call on every request. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Server-only - never expose to the browser. Fine-grained GitHub PAT scoped to
# only labeeleai-lab/LABEELE.AI, with Contents: Read and write permission and
# nothing else. Powers the admin portal's Code (IDE) section.
GITHUB_TOKEN=

# Server-only - never expose to the browser. Must match ADMIN_API_SECRET on
# the Duke backend (backend/.env.example) exactly. Used by
# app/api/admin/duke/[...path]/route.ts (training, personas, annotation,
# stats) and app/api/admin/team/*, app/api/admin/messages (team management,
# contact form inbox) to authenticate admin calls to the backend - the
# browser never sees this value or talks to those backend endpoints directly.
DUKE_ADMIN_SECRET=

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Optional: Feature Flags
# NEXT_PUBLIC_ENABLE_VISION=true
# NEXT_PUBLIC_ENABLE_MARKETPLACE=true