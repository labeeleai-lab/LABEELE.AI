# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Duke backend (backend/coordinator_api.py)
NEXT_PUBLIC_API_URL=https://labeelea1-labeele-duke-prod.hf.space

# Supabase (auth, sessions, contact form, query history)
# Settings -> API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only - never expose to the browser. Used only in app/api/account/delete
# to let a signed-in user delete their own account via the Supabase Admin API,
# and by the admin portal (isAdmin() checks against admin_users) in lib/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only - never expose to the browser. Fine-grained GitHub PAT scoped to
# only labeeleai-lab/LABEELE.AI, with Contents: Read and write permission and
# nothing else. Powers the admin portal's Code (IDE) section.
GITHUB_TOKEN=

# Server-only - never expose to the browser. Must match ADMIN_API_SECRET on
# the Duke backend (backend/.env.example) exactly. Used only by
# app/api/admin/duke/[...path]/route.ts to authenticate admin calls
# (training, personas, annotation, stats) to the backend - the browser never
# sees this value or talks to those backend endpoints directly.
DUKE_ADMIN_SECRET=

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Optional: Feature Flags
# NEXT_PUBLIC_ENABLE_VISION=true
# NEXT_PUBLIC_ENABLE_MARKETPLACE=true