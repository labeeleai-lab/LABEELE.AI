# Copy to .env and fill in real values. Never commit the real .env file.

# Required - app raises an error at startup if this is unset or left as the placeholder value.
# Also signs the website's own account/session tokens (routers/accounts.py) - must be set to
# this EXACT same value as JWT_SECRET in frontend/.env.local (and in Vercel's project env vars),
# or the site can't verify its own login sessions.
JWT_SECRET=generate-with-python-secrets.token_urlsafe(32)

# Required for the /api/duke/* and registration email-fallback paths.
# Not required for Duke's chat brain itself (that's fully local, no external AI calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres (Neon) in production - required for the knowledge system, since
# pgvector has no SQLite equivalent and this also fixes every table getting
# wiped on every redeploy (the old SQLite default lived on the container's
# local disk). Get this from your Neon project's dashboard -> Connection
# string. Use the DIRECT connection (no "-pooler" in the hostname), not the
# pooled one - this app manages its own SQLAlchemy connection pool, and
# layering that on top of Neon's PgBouncer pooler risks subtle connection
# issues. Run `CREATE EXTENSION IF NOT EXISTS vector;` once via Neon's SQL
# editor (or any Postgres client) before first startup against this URL.
# Previously pointed at a Supabase project that was later deleted/orphaned,
# which crash-looped the whole app until core/models/orm.py was made to
# fail soft instead of hard on a bad connection - see that file's comments.
# Falls back to local SQLite if unset - fine for quick local testing of
# anything that doesn't touch knowledge_chunks.
DATABASE_URL=sqlite:///./duke_ml_production.db

# Knowledge system (Phase 1) tuning - optional, sensible defaults if unset.
KNOWLEDGE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KNOWLEDGE_TOP_K=4
KNOWLEDGE_SIM_THRESHOLD=0.35

# Only needed if LABEELEA1/Duke-Weights-Internal (or wherever the fine-tuned
# checkpoint lives) is a private HF repo - required for the app to download
# the checkpoint at startup.
HF_TOKEN=

# Required to use any /admin/* endpoint (retrain, clear-cache, personas,
# training-data upload, tasks, feedback, stats). The frontend's admin portal
# sends this via its own server-only proxy (never from the browser) - see
# frontend/env.example's DUKE_ADMIN_SECRET, which must be set to the exact
# same value. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this unset makes every /admin/* endpoint refuse all requests (503).
ADMIN_API_SECRET=
